; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TrainOrFail Demo (Copy)"
run/main_scene="uid://crev2inf1u6xe"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Database="*uid://dobteaufurtes"
SaveManager="*uid://bwqfj2w5sixej"
SettingsManager="*uid://csyt0p5ar44py"
SceneTransition="*uid://c2wvsl3rgk8l7"
DialogManager="*uid://nb4suyvp8km4"
Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

