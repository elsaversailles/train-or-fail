[gd_scene format=3]

[sub_resource type="Shader" id="Shader_6w6fk"]
code = "shader_type sky;
render_mode use_debanding;

uniform vec4 sky_top_color : source_color = vec4(0.385, 0.454, 0.55, 1.0);
uniform vec4 sky_horizon_color : source_color = vec4(0.646, 0.656, 0.67, 1.0);
uniform float inv_sky_curve : hint_range(1, 100) = 4.0;
uniform vec4 ground_bottom_color : source_color = vec4(0.2, 0.169, 0.133, 1.0);
uniform vec4 ground_horizon_color : source_color = vec4(0.646, 0.656, 0.67, 1.0);
uniform float inv_ground_curve : hint_range(1, 100) = 30.0;
uniform float sun_angle_max = 0.877;
uniform float inv_sun_curve : hint_range(1, 100) = 22.78;
uniform float exposure : hint_range(0, 128) = 1.0;

uniform sampler2D cloud_texture : filter_linear_mipmap, repeat_enable;
uniform sampler2D cloud_texture2 : filter_linear_mipmap, repeat_enable;
uniform vec2 cloud_direction = vec2(0.1, 0.0);
uniform vec2 cloud_direction2 = vec2(0.05, 0.05);
uniform vec2 cloud_scale = vec2(0.05, 0.05);
uniform float cloud_distance = 0.05;
uniform float cloud_speed = 0.2;
uniform float cloud_speed2 = 0.15;

void sky() {
	float v_angle = clamp(EYEDIR.y, -1.0, 1.0);
	vec3 sky = mix(sky_top_color.rgb, sky_horizon_color.rgb, clamp(pow(1.0 - max(v_angle, 0.0), inv_sky_curve), 0.0, 1.0));

	// Sunlight calculations
	if (LIGHT0_ENABLED) {
		float sun_angle = dot(LIGHT0_DIRECTION, EYEDIR);
		float sun_size = cos(LIGHT0_SIZE);
		if (sun_angle > sun_size) {
			sky = LIGHT0_COLOR * LIGHT0_ENERGY;
		} else if (sun_angle > sun_angle_max) {
			float c2 = (sun_size - sun_angle) / (sun_size - sun_angle_max);
			sky = mix(sky, LIGHT0_COLOR * LIGHT0_ENERGY, clamp(pow(1.0 - c2, inv_sun_curve), 0.0, 1.0));
		}
	}

	// Cloud mapping protected against division by zero
	if (EYEDIR.y > 0.01) {
		vec2 sky_uv = EYEDIR.xz / max(EYEDIR.y, 0.02);
		vec3 clouds = texture(cloud_texture, sky_uv * cloud_scale + TIME * cloud_direction * cloud_speed).rgb
		            - texture(cloud_texture2, sky_uv * cloud_scale + TIME * cloud_direction2 * cloud_speed2).rgb;

		clouds = clouds - smoothstep(0.0, EYEDIR.y, cloud_distance);
		clouds = clamp(clouds, 0.0, 1.0);

		// Softly fade clouds out before reaching the horizon line
		float horizon_fade = smoothstep(0.01, 0.15, EYEDIR.y);
		sky += clouds * horizon_fade;
	}

	vec3 ground = mix(ground_bottom_color.rgb, ground_horizon_color.rgb, clamp(pow(1.0 + min(v_angle, 0.0), inv_ground_curve), 0.0, 1.0));

	COLOR = mix(ground, sky, step(0.0, EYEDIR.y)) * exposure;
}"

